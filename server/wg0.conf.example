# WireGuard server config — template.
# Placeholders are replaced by scripts/deploy-server.sh from keys/.
[Interface]
PrivateKey = __SERVER_PRIVATE_KEY__
Address = 10.8.0.1/24
ListenPort = 51820
SaveConfig = false

[Peer]
# client1 — laptop
PublicKey = __CLIENT1_PUBLIC_KEY__
AllowedIPs = 10.8.0.2/32

[Peer]
# client2 — phone
PublicKey = __CLIENT2_PUBLIC_KEY__
AllowedIPs = 10.8.0.3/32
